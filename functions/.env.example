# Backend Functions Environment Variables
# Copy to .env and fill in your values

# Server port
PORT=5000

# Hasura GraphQL endpoint
NHOST_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Hasura Admin Secret (for local dev only - use proper auth in production)
NHOST_ADMIN_SECRET=hasura_admin_secret

# JWT Secret for token verification
# In production, get this from Nhost cloud
NHOST_JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Webhook Secret for validating Hasura webhook requests
NHOST_WEBHOOK_SECRET=webhook_secret_key_change_this_in_production

# Optional: LLM API Key for llm_call steps
# GEMINI_API_KEY=your-gemini-api-key-here
# GROQ_API_KEY=your-groq-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Node environment
NODE_ENV=development
